{
  "sourceLanguage": "en",
  "strings": {
    "%@ — photo by %@ on Unsplash": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@——照片作者 %2$@，来自 Unsplash"
          }
        }
      }
    },
    "%lld notes": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共 %lld 条笔记"
          }
        }
      }
    },
    "%lld pt": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld pt"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "About Skywrite": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于 Skywrite"
          }
        }
      }
    },
    "Accessibility: remove Skywrite in System Settings › Privacy & Security › Accessibility.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能：到「系统设置 › 隐私与安全性 › 辅助功能」里移除 Skywrite。"
          }
        }
      }
    },
    "After one day": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一天后"
          }
        }
      }
    },
    "After one month": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个月后"
          }
        }
      }
    },
    "After one week": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一周后"
          }
        }
      }
    },
    "After one year": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一年后"
          }
        }
      }
    },
    "After two weeks": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两周后"
          }
        }
      }
    },
    "Also move the %lld notes in %@ to the Trash": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Also move the %lld note in %@ to the Trash"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Also move the %lld notes in %@ to the Trash"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把 %2$@ 里的 %1$lld 张便签也移到废纸篓"
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外观"
          }
        }

        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于 Skywrite"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關於 Skywrite"
          }
        }

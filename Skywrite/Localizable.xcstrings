    },
    "Check for Updates…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查更新…"
          }
        }
      }
    },
    "Check for updates automatically": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动检查更新"
          }
        }
      }

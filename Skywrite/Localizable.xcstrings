    "The photos for previewing note backgrounds are by these photographers on Unsplash.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "预览便签背景用的照片，来自 Unsplash 上的这些摄影师。"

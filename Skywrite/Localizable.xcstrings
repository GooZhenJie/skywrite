            "value": "主題"
          }
        }
      }
    },
    "Then click where the note should go.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按完光标变十字，点哪里便签就放哪里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按完游標變十字，點哪裡便條就放哪裡。"
          }
        }
      }
    },
    "They’ve been closed and unedited for longer than the time you chose. You can put them back from the Trash.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它们关掉后，超过你选的时间都没改过。之后可以从废纸篓放回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它們關掉後，超過你選的時間都沒改過。之後可以從垃圾桶還原。"
          }
        }
      }
    },
    "This removes Skywrite and all associated data from this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会从这台 Mac 上移除 Skywrite 和所有相关数据。"

    },
    "Accessibility: remove Skywrite in System Settings › Privacy & Security › Accessibility.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无障碍：到「系统设置 › 隐私与安全 › 无障碍」里移除 Skywrite。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輔助使用：到「系統設定 › 隱私權與安全性 › 輔助使用」裡移除 Skywrite。"
          }
        }
      }
    },
    "Accessibility: remove Skywrite in System Settings. (macOS 26)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility: remove Skywrite in System Settings › Privacy & Security › Accessibility."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能：到「系统设置 › 隐私与安全性 › 辅助功能」里移除 Skywrite。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輔助使用：到「系統設定 › 隱私權與安全性 › 輔助使用」裡移除 Skywrite。"
          }
        }
      }
    },

    },
    "Once a day, Skywrite asks GitHub whether there’s a newer version. Your notes never leave your Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Skywrite 每天问一次 GitHub 有没有新版本。你的笔记不会离开这台 Mac。"
          }
        }
      }
    },
    "Only the window closes. Skywrite and your notes keep running, and your changes are already saved.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只关窗口，Skywrite 和便签照常运行，改过的设置也已经存好。"
          }
        }
      }
    },
    "Open Notes Folder": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开笔记文件夹"
          }
        }
      }

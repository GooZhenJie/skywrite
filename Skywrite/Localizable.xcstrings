    "Choose": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择"
          }
        }
      }
    },
    "Choose a key, then press it twice to make a note. Skywrite will ask for Accessibility permission so it can notice the key in other apps.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选一个键，按两下就能新建笔记。选好后 Skywrite 会请求辅助功能权限，这样在别的 App 里也能察觉到这个键。"
          }
        }
      }
    },
    "City": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "城市"
          }
        }
      }
    },
    "Clear shortcut": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除快捷键"
          }
        }
      }
    },
    "Click the icon for new note, recent notes and settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点图标：新建、最近的笔记、设置"
          }
        }
      }
    },
    "Click to place a note · Drag to set its size · esc to cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点一下放笔记 · 拖一个框定宽高 · esc 取消"
          }
        }
      }
    },
    "Close Note": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "Close this window when you switch to another app": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切到别的 App 时关掉这个窗口"
          }
        }
      }
    },
    "Closed Notes": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关掉的笔记"
          }
        }
      }
    },
    "Closing a note doesn’t delete its file; deleting moves the file to the Trash.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭笔记不会删文件；删除会把文件移到废纸篓。"
          }
        }
      }
    },
    "Collecting logs…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在收集日志…"
          }
        }
      }
    },
    "Copy": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拷贝"
          }
        }
      }
    },
    "Counted from the last edit, or from when you closed the note if that’s later.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从最后一次编辑算起；关掉的时间更晚时，从关掉时算起。"
          }
        }
      }
    },
    "Cut": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪切"
          }
        }

{
  "sourceLanguage": "en",
  "strings": {
    "%@ — photo by %@ on Unsplash": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@——照片作者 %2$@，来自 Unsplash"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@——照片作者 %2$@，來自 Unsplash"
          }
        }
      }
    },

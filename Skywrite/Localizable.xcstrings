    "Also move the %lld notes in %@ to the Trash": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Also move the %lld note in %@ to the Trash"
